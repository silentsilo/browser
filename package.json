{
  "name": "silentsilo-browser",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.3.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:firefox": "node scripts/build.mjs firefox --store && web-ext lint --source-dir dist/store/firefox --no-config-discovery",
    "test": "vitest run",
    "build": "node scripts/build.mjs all",
    "package": "node scripts/build.mjs all --store",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "0.3.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fflate": "0.8.3",
    "jsdom": "30.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldts": "7.4.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "web-ext": "10.7.0"
  },
  "overrides": {
    "image-size": "2.0.4",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "jsdom": {
      "undici": "8.12.2"
    },
    "cheerio": {
      "undici": "7.30.1"
    },
    "tldts-core": "7.4.18"
  }
}
